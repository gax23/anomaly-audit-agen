# Base de datos
DATABASE_URL=postgresql+psycopg2://audit_user:secure_password@timescaledb:5432/audit_db
REDIS_URL=redis://redis:6379/0

# Seguridad
SECRET_KEY=cambia-esto-por-una-clave-segura-de-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (para acceso externo)
API_KEY_HEADER=X-API-Key

# Modelos ML
MODEL_ARTIFACTS_PATH=/app/artifacts
ANOMALY_THRESHOLD_PERCENTILE=95
INCREMENTAL_BUFFER_SIZE=500

# Conectores ERP
SAP_B1_SERVICE_LAYER_URL=
SAP_B1_USERNAME=
SAP_B1_PASSWORD=
SAP_B1_COMPANY_DB=

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=

ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

# Notificaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alertas@tuempresa.com
ALERT_EMAIL_TO=auditor@tuempresa.com

WEBHOOK_URL=

# Configuración general
ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_CURRENCY=USD
TIMEZONE=America/Mexico_City
